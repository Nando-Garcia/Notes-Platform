  },
  "devDependencies": {
    "@angular/build": "^21.2.25",
    "@angular/cli": "^21.2.25",
    "@angular/compiler-cli": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/platform-browser-dynamic": "^21.2.25",
    "@testing-library/angular": "^19.5.0",
    "@testing-library/user-event": "^14.6.7",
    "@vitest/coverage-v8": "^4.0.3",
    "@vitest/ui": "^4.0.3",
    "happy-dom": "^20.14.5",
