# AWS Configuration
AWS_ACCESS_KEY_ID=example
AWS_SECRET_ACCESS_KEY=example
AWS_REGION=us-east-1
LOCALSTACK_ENDPOINT=http://localhost:4566

# AWS Secrets Manager
SQS_CONFIG_SECRET_ID=sqs/config
DB_CREDENTIALS_SECRET_ID=notesdb/credentials

# Auth
JWT_SECRET=change_me_local_secret
JWT_REFRESH_SECRET=change_me_local_refresh_secret

# CloudWatch Configuration
CLOUDWATCH_LOG_GROUP=/app/backend
USE_CLOUDWATCH=false
LOG_LEVEL=info
NODE_ENV=development

# S3 Configuration
S3_BUCKET=notes-attachments

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=example
DB_PASSWORD=example
DB_NAME=example

# CORS Configuration
CORS_ORIGIN=http://localhost:4200
